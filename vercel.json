{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "bom1"
  ],
  "services": {
    "app": {
      "root": ".",
      "runtime": "python",
      "entrypoint": "vercel_app.py"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/backup",
      "schedule": "30 16 * * *"
    },
    {
      "path": "/api/cron/masters",
      "schedule": "*/5 2,3,4,15,16,17 * * *"
    }
  ]
}
