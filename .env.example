# Copy to .env (never commit .env). The first start copies the logins from the old apps' .env files.
HUB_PORT=8050
# Password for the login page. Leave empty = no login on this PC.
APP_PASSWORD=
# Admin login (all pages + the Admin page, where users and their pages are made)
ADMIN_USER=admin
ADMIN_PASS=
# Optional: a long random text; changing it logs everybody out
# SESSION_SECRET=
# TAFE Channel login: Fetch GRIN (Supplementary Bill) and "Get latest DQMS report" (DQMS)
TAFE_USER=DS1615
TAFE_PASS=
# LEAP login: Upload to LEAP (CHEP)
LEAP_USER=
LEAP_PASS=
# Folder holding SupplementaryBill, CHEPTransfer, DQMSUpload (only if it is not found by itself)
# SDEW_SOURCE=C:\Users\abhin\Downloads\SDEW
# Optional: a Turso cloud database for the hub (website). Then USE_CLOUD_DB=1 makes this PC use it too.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
USE_CLOUD_DB=0

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourmail@gmail.com
SMTP_PASS=abcdefghijklmnop
MAIL_FROM=yourmail@gmail.com
# ---- Backups (on the SDEW PC) ----
# a second copy of every backup, e.g. the Google Drive folder of Google Drive for desktop
# BACKUP_COPY_DIR=G:\My Drive\SDEW Hub backups
# BACKUP_KEEP_DAYS=30
# Website backups without the PC (Vercel Blob). Vercel adds BLOB_READ_WRITE_TOKEN itself when a Blob store
# is connected to the project (Storage > Create > Blob > Private). Put the same token here on the PC and the
# PC's backups go to Blob too, so the website can restore them.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# CRON_SECRET=<any long random text>   (Vercel env only: protects the nightly /api/cron/backup)
# BACKUP_HOUR=21          (nightly backup after this hour; a PC that was off does it when the hub starts)
# BACKUP_NIGHTLY=1        (0 = no nightly backup on this computer)
# ---- Security ----
# MAX_UPLOAD_MB=50        (largest file one upload may send)
# SESSION_SECRET=         (any long random text: signs the login cookie; changing it logs everybody out)
